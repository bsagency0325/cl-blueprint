---
import { Image } from 'astro:assets';
import { content, type Lang } from '../i18n/home';
import { site } from '../config';
import ScoreForm from './ScoreForm.astro';
import answerImg from '../assets/illustrations/answer.jpg';
import foundImg from '../assets/illustrations/found.jpg';
import bookedImg from '../assets/illustrations/booked.jpg';
import pieroImg from '../assets/piero.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
const scoreValues = [52, 18, 35, 60];
const scoreTotal = 41;

const images = { found: foundImg, booked: bookedImg } as const;
const imgWidths = [480, 720, 1024];
const imgSizes = '(max-width: 1000px) calc(100vw - 48px), 560px';
const illustrated = t.system.paths.filter((p) => p.image);
const fullPath = t.system.paths.find((p) => !p.image)!;

// Line icons for the four leaks, drawn on a 24×24 grid in the blueprint style.
const leakIcons = [
  '<path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11z" stroke-dasharray="2.5 2"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9V12M12 14.2v.1"/>',
  '<path d="M5 4h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/><path d="M15 3.5l5.5 5.5M20.5 3.5L15 9"/>',
  '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" stroke-dasharray="2.5 2"/>',
  '<path d="M6 3h8l4 4v6"/><path d="M6 3v18h7"/><path d="M14 3v4h4M9 10h6M9 13.5h4"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="M17.5 15.8v1.9l1.2.8"/>',
];
---
<main>
  <!-- HERO: the free Score is the one goal of the page -->
  <section class="hero grid-bg spot">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.sub}</p>
        <ScoreForm lang={lang} id={ids.score} uid={`${lang}-top`} />
        <p class="trust"><span class="dot" aria-hidden="true"></span>{t.hero.trust}</p>
      </div>

      <div class="score-card card" aria-hidden="true" data-score>
        <div class="score-top">
          <span class="mono label">{t.hero.card.label}</span>
          <img src="/brand/icon.svg" alt="" width="14" height="28" />
        </div>
        <div class="score-value"><span data-count={scoreTotal}>{scoreTotal}</span><span class="out">/ 100</span></div>
        <div class="bars">
          {t.hero.card.metrics.map((m, i) => (
            <div class="bar">
              <div class="bar-row"><span>{m}</span><span class="mono" data-count={scoreValues[i]}>{scoreValues[i]}</span></div>
              <div class="track"><div class="fill" style={`--w:${scoreValues[i]}%`}></div></div>
            </div>
          ))}
        </div>
        <div class="score-foot">
          <span>{t.hero.card.lost}</span>
          <span class="lost">$•,•••</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.leaks.eyebrow}</p>
        <h2>{t.leaks.title}</h2>
        <p>{t.leaks.sub}</p>
      </div>
      <div class="leaks" data-reveal>
        {t.leaks.items.map((item, i) => (
          <div class="leak card lift">
            <div class="leak-top">
              <svg class="icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={leakIcons[i]} />
              <span class="mono num">0{i + 1}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <p class="closing" data-reveal>{t.leaks.closing}</p>
    </div>
  </section>

  <!-- THE SYSTEM -->
  <section class="section grid-bg spot" id={ids.system}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.system.eyebrow}</p>
        <h2>{t.system.title}</h2>
        <p>{t.system.sub}</p>
      </div>

      <!-- Foundation: illustration + what's included + live text-back example -->
      <div class="foundation card">
        <div class="illo-block" data-reveal>
          <figure class="illo">
            <Image src={answerImg} alt={t.system.foundation.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
          </figure>
        </div>
        <div class="foundation-copy">
          <span class="mono tag">{t.system.foundation.label}</span>
          <h3>{t.system.foundation.title}</h3>
          <p class="foundation-body">{t.system.foundation.body}</p>
          <ul class="ticks">
            {t.system.foundation.items.map((it) => <li>{it}</li>)}
          </ul>
          <div class="demo" data-demo>
            <p class="mono demo-label">{t.system.foundation.demoLabel}</p>
            <ol class="thread">
              {t.system.foundation.demo.map((m) => (
                <li class={`msg msg-${m.from}`}>{m.text}</li>
              ))}
            </ol>
          </div>
        </div>
      </div>

      <!-- Get Found + Get Booked: same layout as the foundation, each with its own example screen -->
      {illustrated.map((p, n) => (
        <div class={`path card${n % 2 ? ' flip' : ''}`}>
          <figure class="illo" data-reveal>
            <Image src={images[p.image as keyof typeof images]} alt={p.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
          </figure>
          <div class="path-copy">
            <span class="mono tag">{p.tag}</span>
            <h3>{p.name}</h3>
            <p class="for">{p.for}</p>
            <ul class="ticks">
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
            {p.demo?.kind === 'maps' && (
              <div class="demo" data-demo>
                <p class="mono demo-label">{p.demo.label}</p>
                <div class="msg search mono"><span aria-hidden="true">⌕</span>{p.demo.search}</div>
                <ol class="results">
                  {p.demo.results.map((r, i) => (
                    <li class={`msg result${i === 0 ? ' top' : ''}`}>
                      <span class="pin" aria-hidden="true"></span>
                      <span class="r-name">{r.name}</span>
                      <span class="stars" aria-label={`${r.stars}/5`}>{'★'.repeat(r.stars)}<span class="off">{'★'.repeat(5 - r.stars)}</span></span>
                      {r.tag && <span class="mono r-tag">{r.tag}</span>}
                    </li>
                  ))}
                </ol>
                <div class="msg ask">{p.demo.ask}</div>
                <div class="msg answer">{p.demo.answer}</div>
              </div>
            )}
            {p.demo?.kind === 'booked' && (
              <div class="demo" data-demo>
                <p class="mono demo-label">{p.demo.label}</p>
                <div class="msg ad">
                  <span class="mono ad-tag">{p.demo.adTag}</span>
                  <p>{p.demo.ad}</p>
                  <span class="ad-btn">{p.demo.adButton}</span>
                </div>
                <div class="msg msg-note">↓</div>
                <div class="msg lead-msg mono">{p.demo.lead}</div>
                <div class="msg msg-note">↓</div>
                <div class="msg msg-booked">{p.demo.booked}</div>
              </div>
            )}
          </div>
        </div>
      ))}

      <!-- Full Blueprint -->
      <div class="full card" data-reveal>
        <div>
          <span class="mono tag">{fullPath.tag}</span>
          <h3>{fullPath.name}</h3>
          <p class="for">{fullPath.for}</p>
        </div>
        <p class="path-body">{fullPath.body}</p>
      </div>

      <div class="system-close" data-reveal>
        <p class="closing">{t.system.closing}</p>
        <a class="btn btn-primary" href={`#${ids.score}`} data-focus-form>{t.system.cta}</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: a 4-step timeline -->
  <section class="section" id={ids.how}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <ol class="timeline" data-reveal>
        {t.how.steps.map((s, i) => (
          <li>
            <span class="node mono" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- GUARANTEES: the one light section, so it stands out -->
  <section class="section light" id={ids.guarantee}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.guarantee.eyebrow}</p>
      </div>
      <div class="g-wrap" data-reveal>
        <div class="g-main">
          <h3>{t.guarantee.title}</h3>
          <p>{t.guarantee.body}</p>
        </div>
        <div class="g-tiles">
          {t.guarantee.items.map((g) => (
            <div class="g-tile">
              <span class="mono g-label">{g.label}</span>
              <p>{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section">
    <div class="wrap founder" data-reveal>
      <div class="photo">
        <Image src={pieroImg} alt={t.founder.photoAlt} widths={[400, 640, 900]} sizes="(max-width: 1000px) 360px, 400px" format="webp" quality={80} loading="lazy" />
      </div>
      <div class="founder-copy">
        <p class="eyebrow">{t.founder.eyebrow}</p>
        <h2>{t.founder.title}</h2>
        <p class="lead">{t.founder.body}</p>
        <ul class="details mono">
          {t.founder.details.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id={ids.faq}>
    <div class="wrap faq-wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.title}</h2>
      </div>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL: the Score form again, with Piero's calendar beside it -->
  <section class="section grid-bg spot final" id={ids.contact}>
    <div class="wrap final-grid">
      <div class="final-score" data-reveal>
        <span class="mono tag">{t.final.scoreTitle}</span>
        <h2>{t.final.title}</h2>
        <p class="lead">{t.final.scoreBody}</p>
        <ScoreForm lang={lang} uid={`${lang}-end`} />
      </div>
      <div class="final-book card" data-reveal>
        <span class="mono tag">15 min</span>
        <h3>{t.final.bookTitle}</h3>
        <p>{t.final.bookBody}</p>
        {site.calendarUrl
          ? <iframe class="calendar" src={site.calendarUrl} title={t.final.bookTitle} loading="lazy"></iframe>
          : <a class="btn btn-ghost" href={`mailto:${site.email}`}>{t.final.bookFallback}</a>}
        {(site.phone || site.whatsapp) && (
          <div class="contact">
            {site.phone && <a href={`sms:${site.phone}`}>{t.final.phone}</a>}
            {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">{t.final.whatsapp}</a>}
          </div>
        )}
      </div>
    </div>
  </section>
</main>

<script>
  // Motion effects. Skipped entirely for visitors who prefer reduced motion,
  // so everything is simply visible for them (and without JavaScript).
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('fx');

    const once = (els: Iterable<Element>, fn: (el: Element) => void, threshold = 0.2) => {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { fn(e.target); io.unobserve(e.target); }
      }, { threshold, rootMargin: '0px 0px -40px 0px' });
      for (const el of els) io.observe(el);
    };

    // Sections fade in as they enter.
    once(document.querySelectorAll('[data-reveal]'), (el) => el.classList.add('in'), 0.12);

    // Score card counts up and its bars fill.
    once(document.querySelectorAll('[data-score]'), (card) => {
      card.classList.add('in');
      for (const n of card.querySelectorAll<HTMLElement>('[data-count]')) {
        const end = Number(n.dataset.count);
        const t0 = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / 1200);
          n.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        n.textContent = '0';
        requestAnimationFrame(tick);
      }
    }, 0.3);

    // Text-back example: messages arrive one by one.
    once(document.querySelectorAll('[data-demo]'), (demo) => {
      demo.querySelectorAll('.msg').forEach((m, i) => setTimeout(() => m.classList.add('shown'), 300 + i * 850));
    }, 0.4);

    // Blueprint grid lights up around the cursor (mouse and trackpad only).
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      for (const sec of document.querySelectorAll<HTMLElement>('.spot')) {
        sec.addEventListener('pointermove', (e) => {
          const r = sec.getBoundingClientRect();
          sec.style.setProperty('--mx', `${e.clientX - r.left}px`);
          sec.style.setProperty('--my', `${e.clientY - r.top}px`);
          sec.classList.add('lit');
        });
        sec.addEventListener('pointerleave', () => sec.classList.remove('lit'));
      }
    }
  }
</script>

<style>
  .lead { color: var(--body); font-size: 20px; line-height: 1.55; }
  .tag { color: var(--lime); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .num { color: var(--lime); font-size: 13px; }
  .closing { margin-top: 40px; font-family: var(--font-display); font-weight: 500; font-size: 24px; color: var(--chalk); max-width: 760px; }

  /* Blueprint grid spotlight */
  .spot { position: relative; }
  .spot > .wrap { position: relative; z-index: 1; }
  .spot::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background-image:
      linear-gradient(rgba(156, 226, 74, 0.28) 1px, transparent 1px),
      linear-gradient(90deg, rgba(156, 226, 74, 0.28) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    transition: opacity .35s ease;
  }
  .spot.lit::after { opacity: 1; }

  /* Hover cards lift and flip to Chalk (like the old site) */
  .lift { transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
  @media (hover: hover) {
    .lift:hover { transform: translateY(-4px); background: var(--chalk); border-color: var(--chalk); }
    .lift:hover h3 { color: var(--navy); }
    .lift:hover p { color: #2b3a48; }
    .lift:hover .num, .lift:hover .icon { color: var(--lime-ink); }
  }

  /* Sections fade in (only when the script turns motion on) */
  :global(.fx) [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  :global(.fx) [data-reveal].in { opacity: 1; transform: none; }

  /* Hero */
  .hero { padding: 88px 0 104px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.0; }
  .trust { display: flex; align-items: center; gap: 12px; color: #d5dde4; font-size: 16px; }
  .dot { width: 10px; height: 10px; background: var(--lime); flex-shrink: 0; }

  .score-card { padding: 28px; display: flex; flex-direction: column; gap: 22px; justify-self: end; width: 100%; max-width: 440px; }
  .score-top { display: flex; justify-content: space-between; align-items: center; }
  .score-top img { height: 28px; width: auto; }
  .label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .score-value { font-family: var(--font-display); font-weight: 700; font-size: 84px; line-height: 1; display: flex; align-items: baseline; gap: 10px; font-variant-numeric: tabular-nums; }
  .out { font-size: 28px; font-weight: 500; color: var(--steel); }
  .bars { display: flex; flex-direction: column; gap: 14px; }
  .bar-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px; }
  .bar-row .mono { color: var(--steel); }
  .track { height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .fill { height: 8px; border-radius: 4px; background: var(--lime); width: var(--w); }
  :global(.fx) [data-score] .fill { width: 0; transition: width 1.2s cubic-bezier(.2, .7, .2, 1); }
  :global(.fx) [data-score].in .fill { width: var(--w); }
  .score-foot { border-top: 1px solid var(--line); padding-top: 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 14px; color: var(--body); }
  .lost { font-family: var(--font-display); font-weight: 700; font-size: 28px; color: var(--lime); }

  /* Leaks */
  .leaks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .leak { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .leak-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .icon { color: var(--lime); transition: color .2s ease; }
  .leak h3 { font-size: 22px; }
  .leak p { color: var(--body); font-size: 16px; }

  /* Illustrations: framed, no text on the drawing */
  .illo { margin: 0; background: var(--panel); border-radius: 10px; overflow: hidden; }
  .illo :global(img) { width: 100%; height: auto; }

  /* System */
  .foundation { padding: 32px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; border-color: var(--lime); margin-bottom: 16px; align-items: center; }
  .foundation-copy { display: flex; flex-direction: column; gap: 14px; }
  .foundation h3 { font-size: clamp(28px, 3.4vw, 38px); }
  .foundation-body { color: var(--chalk); font-size: 19px; }
  .demo { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; background: var(--navy); border: 1px solid var(--line); border-radius: 12px; padding: 18px; }
  .demo-label { color: var(--steel); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }
  .thread { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .msg { max-width: 85%; padding: 9px 13px; border-radius: 14px; font-size: 15px; line-height: 1.4; }
  .msg-note { align-self: center; max-width: none; padding: 2px 0 6px; font: 500 12px var(--font-mono); color: var(--steel); }
  .msg-in { align-self: flex-start; background: var(--line); color: var(--chalk); border-bottom-left-radius: 4px; }
  .msg-out { align-self: flex-end; background: var(--lime); color: var(--navy); border-bottom-right-radius: 4px; }
  .msg-booked { align-self: stretch; max-width: none; text-align: center; border: 1px dashed var(--lime); color: var(--lime); font: 500 13px var(--font-mono); border-radius: 8px; margin-top: 4px; }
  :global(.fx) [data-demo] .msg { opacity: 0; transform: translateY(8px); transition: opacity .4s ease, transform .4s ease; }
  :global(.fx) [data-demo] .msg.shown { opacity: 1; transform: none; }

  .path { padding: 32px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; margin-bottom: 16px; }
  .path.flip .illo { order: 2; }
  .path-copy { display: flex; flex-direction: column; gap: 14px; }

  /* Path example screens */
  .search { max-width: none; align-self: stretch; display: flex; gap: 10px; align-items: center; background: var(--chalk); color: var(--navy); border-radius: 999px; font-size: 13px; padding: 9px 16px; }
  .search span { font-size: 16px; line-height: 1; }
  .results { list-style: none; margin: 4px 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .result { max-width: none; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; border: 1px solid var(--line); border-radius: 10px; color: #d5dde4; }
  .result .pin { width: 10px; height: 10px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--steel); }
  .result.top { border-color: var(--lime); color: var(--chalk); }
  .result.top .pin { background: var(--lime); }
  .stars { color: var(--lime); letter-spacing: 1px; font-size: 13px; }
  .stars .off { color: var(--line); }
  .r-tag { grid-column: 2 / -1; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lime); }
  .ask { align-self: flex-end; background: var(--line); color: var(--chalk); border-bottom-right-radius: 4px; }
  .answer { align-self: flex-start; background: var(--panel); border: 1px solid var(--lime); color: var(--chalk); border-bottom-left-radius: 4px; }
  .ad { max-width: none; align-self: stretch; background: var(--chalk); color: var(--navy); border-radius: 12px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .ad p { font-weight: 500; }
  .ad-tag { font-size: 11px; color: #4f5d6b; letter-spacing: 0.08em; text-transform: uppercase; }
  .ad-btn { background: var(--lime); color: var(--navy); font-weight: 500; font-size: 14px; padding: 6px 14px; border-radius: 6px; }
  .lead-msg { max-width: none; align-self: stretch; text-align: center; background: var(--line); color: var(--chalk); font-size: 13px; border-radius: 8px; }
  .path h3 { font-size: clamp(28px, 3.4vw, 38px); }
  .full h3 { font-size: 30px; }
