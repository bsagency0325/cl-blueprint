---
import { Image } from 'astro:assets';
import { content, type Lang } from '../i18n/home';
import { site } from '../config';
import ScoreForm from './ScoreForm.astro';
import answerImg from '../assets/illustrations/answer.jpg';
import foundImg from '../assets/illustrations/found.jpg';
import bookedImg from '../assets/illustrations/booked.jpg';
import pieroImg from '../assets/piero.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
const scoreValues = [52, 18, 35, 60];
const scoreTotal = 41;

const images = { found: foundImg, booked: bookedImg } as const;
const imgWidths = [480, 720, 1024];
const imgSizes = '(max-width: 1000px) calc(100vw - 48px), 560px';
const illustrated = t.system.paths.filter((p) => p.image);
const fullPath = t.system.paths.find((p) => !p.image)!;

// Line icons for the four leaks, drawn on a 24×24 grid in the blueprint style.
// Every stroke uses pathLength=100 so all four icons draw in exactly the same time.
const leakIcons = [
  '<path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11z" class="dash" style="--dash:5.6 4.5"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9V12M12 14.2v.1"/>',
  '<path d="M5 4h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/><path d="M15 3.5l5.5 5.5M20.5 3.5L15 9"/>',
  '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" class="dash" style="--dash:4.05 3.24"/>',
  '<path d="M6 3h8l4 4v6"/><path d="M6 3v18h7"/><path d="M14 3v4h4M9 10h6M9 13.5h4"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="M17.5 15.8v1.9l1.2.8"/>',
];
---
<main>
  <!-- HERO: the free Score is the one goal of the page -->
  <section class="hero grid-bg spot">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.sub}</p>
        <ScoreForm lang={lang} id={ids.score} uid={`${lang}-top`} />
        <p class="trust"><span class="dot" aria-hidden="true"></span>{t.hero.trust}</p>
      </div>

      <div class="score-card card" aria-hidden="true" data-score>
        <div class="score-top">
          <span class="mono label">{t.hero.card.label}</span>
          <img src="/brand/icon.svg" alt="" width="14" height="28" />
        </div>
        <div class="score-value"><span data-count={scoreTotal}>{scoreTotal}</span><span class="out">/ 100</span></div>
        <div class="bars">
          {t.hero.card.metrics.map((m, i) => (
            <div class="bar">
              <div class="bar-row"><span>{m}</span><span class="mono" data-count={scoreValues[i]}>{scoreValues[i]}</span></div>
              <div class="track"><div class="fill" style={`--w:${scoreValues[i]}%`}></div></div>
            </div>
          ))}
        </div>
        <div class="score-foot">
          <span>{t.hero.card.lost}</span>
          <span class="lost">$•,•••</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.leaks.eyebrow}</p>
        <h2>{t.leaks.title}</h2>
        <p>{t.leaks.sub}</p>
      </div>
      <div class="leaks" data-reveal>
        {t.leaks.items.map((item, i) => (
          <div class="leak card lift">
            <div class="leak-top">
              <svg class="icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={leakIcons[i].replace(/<(path|circle) /g, '<$1 pathLength="100" ')} />
              <span class="mono num">0{i + 1}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <p class="closing" data-reveal>{t.leaks.closing}</p>
    </div>
  </section>

  <!-- THE SYSTEM -->
  <section class="section grid-bg spot" id={ids.system}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.system.eyebrow}</p>
        <h2>{t.system.title}</h2>
        <p>{t.system.sub}</p>
      </div>

      <!-- Foundation (full width): illustration + what's included + live AI call / text-back example -->
      <div class="foundation card sys">
        <figure class="illo" data-reveal>
          <Image src={answerImg} alt={t.system.foundation.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
        </figure>
        <div class="foundation-copy">
          <span class="mono tag">{t.system.foundation.label}</span>
          <h3>{t.system.foundation.title}</h3>
          <p class="foundation-body">{t.system.foundation.body}</p>
          <ul class="ticks">
            {t.system.foundation.items.map((it) => <li>{it}</li>)}
          </ul>
          <div class="demo" data-demo data-tabs>
            <div class="demo-top">
              <p class="mono demo-label">{t.system.foundation.demoLabel}</p>
              <div class="tabs" role="tablist">
                <button type="button" role="tab" class="tab" aria-selected="true" data-tab="call">{t.system.foundation.call.tabCall}</button>
                <button type="button" role="tab" class="tab" aria-selected="false" data-tab="text">{t.system.foundation.call.tabText}</button>
              </div>
            </div>
            <div class="pane" data-pane="call" role="tabpanel">
              <div class="msg call-in mono"><span class="ring" aria-hidden="true"></span>{t.system.foundation.call.incoming}</div>
              <div class="msg call-live">
                <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                <span>{t.system.foundation.call.answered}</span>
              </div>
              {t.system.foundation.call.lines.map((l) => (
                <div class={`msg line line-${l.who}`}>
                  <span class="mono who">{l.who === 'ai' ? t.system.foundation.call.aiLabel : t.system.foundation.call.callerLabel}</span>
                  <span>{l.text}</span>
                </div>
              ))}
              <div class="msg msg-booked">{t.system.foundation.call.booked}</div>
            </div>
            <div class="pane" data-pane="text" role="tabpanel">
              {t.system.foundation.demo.map((m) => (
                <div class={`msg msg-${m.from}`}>{m.text}</div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Get Found + Get Booked, side by side under the foundation -->
      <div class="paths">
        {illustrated.map((p) => (
          <div class="path card sys">
            <figure class="illo" data-reveal>
              <Image src={images[p.image as keyof typeof images]} alt={p.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
            </figure>
            <div class="path-copy">
              <span class="mono tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p class="for">{p.for}</p>
              <ul class="ticks">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
            {p.demo?.kind === 'maps' && (
              <div class="demo" data-demo>
                <p class="mono demo-label">{p.demo.label}</p>
                <div class="msg search mono"><span aria-hidden="true">⌕</span>{p.demo.search}</div>
                {p.demo.results.map((r, i) => (
                  <div class={`msg result${i === 0 ? ' top' : ''}`}>
                    <span class="pin" aria-hidden="true"></span>
                    <span class="r-name">{r.name}</span>
                    <span class="stars" aria-label={`${r.stars}/5`}>{'★'.repeat(r.stars)}<span class="off">{'★'.repeat(5 - r.stars)}</span></span>
                    {r.tag && <span class="mono r-tag">{r.tag}</span>}
                  </div>
                ))}
                <div class="msg ask">{p.demo.ask}</div>
                <div class="msg answer"><span class="mono who">AI</span>{p.demo.answer}</div>
              </div>
            )}
            {p.demo?.kind === 'booked' && (
              <div class="demo" data-demo>
                <p class="mono demo-label">{p.demo.label}</p>
                <div class="msg post">
                  <div class="post-head">
                    <span class="avatar" aria-hidden="true"><img src="/brand/icon.svg" alt="" width="8" height="16" /></span>
                    <span class="post-who"><strong>{p.demo.page}</strong><span class="mono">{p.demo.where}</span></span>
                  </div>
                  <p class="post-text">{p.demo.ad}</p>
                  <div class="post-media" aria-hidden="true">
                    <svg viewBox="0 0 120 60" width="120" height="60" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="38" y="10" width="44" height="40" rx="3"/><circle cx="60" cy="30" r="13"/><circle cx="60" cy="30" r="8"/><circle cx="60" cy="30" r="3"/><path d="M42 50h36M30 30h4M86 30h4M60 4v3"/></svg>
                  </div>
                </div>
                <div class="msg flow-arrow" aria-hidden="true">↓</div>
                <div class="msg lead-msg mono">{p.demo.lead}</div>
                <div class="msg flow-arrow" aria-hidden="true">↓</div>
                <div class="msg msg-booked">{p.demo.booked}</div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Full Blueprint -->
      <div class="full card sys" data-reveal>
        <div>
          <span class="mono tag">{fullPath.tag}</span>
          <h3>{fullPath.name}</h3>
          <p class="for">{fullPath.for}</p>
        </div>
        <p class="path-body">{fullPath.body}</p>
      </div>

      <div class="system-close" data-reveal>
        <p class="closing">{t.system.closing}</p>
        <a class="btn btn-primary" href={`#${ids.score}`} data-focus-form>{t.system.cta}</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: a 4-step timeline -->
  <section class="section" id={ids.how}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <ol class="timeline" data-reveal>
        {t.how.steps.map((s, i) => (
          <li>
            <span class="node mono" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- GUARANTEE: a stopwatch that answers well before 60 seconds -->
  <section class="section grid-bg spot guarantee" id={ids.guarantee}>
    <div class="wrap g-grid">
      <div class="clock" data-clock data-reveal aria-hidden="true">
        <svg viewBox="0 0 220 220" width="220" height="220">
          <circle class="dial" cx="110" cy="110" r="96" />
          {Array.from({ length: 60 }, (_, i) => (
            <line class={i % 5 ? 'tick' : 'tick major'} x1="110" y1={i % 5 ? 20 : 16} x2="110" y2="26" transform={`rotate(${i * 6} 110 110)`} />
          ))}
          <circle class="sweep" cx="110" cy="110" r="96" pathLength="60" />
        </svg>
        <div class="clock-read">
          <span class="mono clock-time" data-clock-time>0:09</span>
          <span class="mono clock-stamp">{t.guarantee.clock} ✓</span>
        </div>
      </div>
      <div class="g-copy" data-reveal>
        <p class="eyebrow">{t.guarantee.eyebrow}</p>
        <h2>{t.guarantee.title}</h2>
        <p class="lead">{t.guarantee.body}</p>
        <ul class="g-list">
          {t.guarantee.items.map((g) => (
            <li>
              <span class="mono g-label">{g.label}</span>
              <span>{g.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section">
    <div class="wrap founder" data-reveal>
      <div class="photo">
        <Image src={pieroImg} alt={t.founder.photoAlt} widths={[400, 640, 900]} sizes="(max-width: 1000px) 360px, 400px" format="webp" quality={80} loading="lazy" />
      </div>
      <div class="founder-copy">
        <p class="eyebrow">{t.founder.eyebrow}</p>
        <h2>{t.founder.title}</h2>
        <p class="lead">{t.founder.body}</p>
        <ul class="details mono">
          {t.founder.details.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id={ids.faq}>
    <div class="wrap faq-wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.title}</h2>
      </div>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL: the Score form again, with Piero's calendar beside it -->
  <section class="section grid-bg spot final" id={ids.contact}>
    <div class="wrap final-grid">
      <div class="final-score" data-reveal>
        <span class="mono tag">{t.final.scoreTitle}</span>
        <h2>{t.final.title}</h2>
        <p class="lead">{t.final.scoreBody}</p>
        <ScoreForm lang={lang} uid={`${lang}-end`} />
      </div>
      <div class="final-book card" data-reveal>
        <span class="mono tag">15 min</span>
        <h3>{t.final.bookTitle}</h3>
        <p>{t.final.bookBody}</p>
        {site.calendarUrl
          ? <iframe class="calendar" src={site.calendarUrl} title={t.final.bookTitle} loading="lazy"></iframe>
          : <a class="btn btn-ghost" href={`mailto:${site.email}`}>{t.final.bookFallback}</a>}
        {(site.phone || site.whatsapp) && (
          <div class="contact">
            {site.phone && <a href={`sms:${site.phone}`}>{t.final.phone}</a>}
            {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">{t.final.whatsapp}</a>}
          </div>
        )}
      </div>
    </div>
  </section>
</main>

<script>
  // Foundation example: tabs between the AI receptionist call and the missed-call text-back.
  const timers = new WeakMap<Element, number[]>();
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const motion = !calm && 'IntersectionObserver' in window;

  // Show a demo's messages one by one (or all at once without motion).
  const play = (root: Element, onDone?: () => void) => {
    for (const id of timers.get(root) ?? []) clearTimeout(id);
    const msgs = [...root.querySelectorAll('.msg')];
    if (!motion) { msgs.forEach((m) => m.classList.add('shown')); return; }
    msgs.forEach((m) => m.classList.remove('shown'));
    const ids = msgs.map((m, i) => window.setTimeout(() => m.classList.add('shown'), 250 + i * 750));
    if (onDone) ids.push(window.setTimeout(onDone, 250 + msgs.length * 750 + 2600));
    timers.set(root, ids);
  };

  for (const demo of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    document.documentElement.classList.add('js-tabs');
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...demo.querySelectorAll<HTMLElement>('[data-pane]')];
    let touched = false;
    const show = (name: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
      panes.forEach((p) => (p.hidden = p.dataset.pane !== name));
      const pane = panes.find((p) => p.dataset.pane === name)!;
      // After the call plays, move on to the text-back once, unless the visitor picked a tab.
      play(pane, name === 'call' ? () => { if (!touched) show('text'); } : undefined);
    };
    tabs.forEach((t) => t.addEventListener('click', () => { touched = true; show(t.dataset.tab!); }));
    demo.addEventListener('demo:start', () => show('call'), { once: true });
    panes.forEach((p) => (p.hidden = p.dataset.pane !== 'call'));
  }

  if (motion) {
    document.documentElement.classList.add('fx');

    const once = (els: Iterable<Element>, fn: (el: Element) => void, threshold = 0.2) => {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { fn(e.target); io.unobserve(e.target); }
      }, { threshold, rootMargin: '0px 0px -40px 0px' });
      for (const el of els) io.observe(el);
    };

    // Sections fade in as they enter.
    once(document.querySelectorAll('[data-reveal]'), (el) => el.classList.add('in'), 0.12);

    // Score card counts up and its bars fill.
    const countUp = (n: HTMLElement, end: number, ms: number, fmt = (v: number) => String(v)) => {
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / ms);
        n.textContent = fmt(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    once(document.querySelectorAll('[data-score]'), (card) => {
      card.classList.add('in');
      for (const n of card.querySelectorAll<HTMLElement>('[data-count]')) countUp(n, Number(n.dataset.count), 1200);
    }, 0.3);

    // Example screens play when they scroll into view.
    once(document.querySelectorAll('[data-demo]'), (demo) => {
      if (demo.hasAttribute('data-tabs')) demo.dispatchEvent(new Event('demo:start'));
      else play(demo);
    }, 0.35);

    // Guarantee stopwatch: sweeps, stops well under a minute, gets stamped.
    once(document.querySelectorAll('[data-clock]'), (clock) => {
      clock.classList.add('run');
      const out = clock.querySelector<HTMLElement>('[data-clock-time]')!;
      countUp(out, 9, 1600, (v) => `0:${String(v).padStart(2, '0')}`);
      setTimeout(() => clock.classList.add('done'), 1700);
    }, 0.4);

    // Mouse and trackpad only: the grid lights up around the cursor, and the
    // drawings get a drafting crosshair that reads coordinates off the drawing.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      for (const sec of document.querySelectorAll<HTMLElement>('.spot')) {
        sec.addEventListener('pointermove', (e) => {
          const r = sec.getBoundingClientRect();
          sec.style.setProperty('--mx', `${e.clientX - r.left}px`);
          sec.style.setProperty('--my', `${e.clientY - r.top}px`);
          sec.classList.add('lit');
        });
        sec.addEventListener('pointerleave', () => sec.classList.remove('lit'));
      }
      for (const fig of document.querySelectorAll<HTMLElement>('.illo')) {
        const xh = document.createElement('div');
        xh.className = 'xhair';
        xh.setAttribute('aria-hidden', 'true');
        xh.innerHTML = '<span class="xh"></span><span class="yh"></span><span class="xy"></span>';
        fig.append(xh);
        const xy = xh.querySelector<HTMLElement>('.xy')!;
        fig.addEventListener('pointermove', (e) => {
          const r = fig.getBoundingClientRect();
          const x = e.clientX - r.left, y = e.clientY - r.top;
          xh.style.setProperty('--cx', `${x}px`);
          xh.style.setProperty('--cy', `${y}px`);
          xh.classList.toggle('flip', x > r.width - 130);
          xh.classList.toggle('up', y > r.height - 34);
          // Read in drawing units (0–1000 across the drawing), like a plan sheet.
          const ux = Math.round((x / r.width) * 1000), uy = Math.round((y / r.width) * 1000);
          xy.textContent = `X ${String(ux).padStart(4, '0')} · Y ${String(uy).padStart(4, '0')}`;
          xh.classList.add('on');
        });
        fig.addEventListener('pointerleave', () => xh.classList.remove('on'));
      }
    }

    // Scroll ruler along the top edge.
    const ruler = document.createElement('div');
    ruler.className = 'ruler';
    ruler.setAttribute('aria-hidden', 'true');
    ruler.innerHTML = '<i></i>';
    document.body.append(ruler);
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      ruler.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .lead { color: var(--body); font-size: 20px; line-height: 1.55; }
  .tag { color: var(--lime); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .num { color: var(--lime); font-size: 13px; }
  .closing { margin-top: 40px; font-family: var(--font-display); font-weight: 500; font-size: 24px; color: var(--chalk); max-width: 760px; }

  /* Blueprint grid spotlight */
  .spot { position: relative; }
  .spot > .wrap { position: relative; z-index: 1; }
  .spot::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background-image:
      linear-gradient(rgba(156, 226, 74, 0.28) 1px, transparent 1px),
      linear-gradient(90deg, rgba(156, 226, 74, 0.28) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    transition: opacity .35s ease;
  }
  .spot.lit::after { opacity: 1; }

  /* Hover cards lift and flip to Chalk (like the old site) */
  .lift { transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
  @media (hover: hover) {
    .lift:hover { transform: translateY(-4px); background: var(--chalk); border-color: var(--chalk); }
    .lift:hover h3 { color: var(--navy); }
    .lift:hover p { color: #2b3a48; }
    .lift:hover .num, .lift:hover .icon { color: var(--lime-ink); }
  }

  /* Sections fade in (only when the script turns motion on) */
  :global(.fx) [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  :global(.fx) [data-reveal].in { opacity: 1; transform: none; }

  /* Hero */
  .hero { padding: 88px 0 104px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.0; }
  .trust { display: flex; align-items: center; gap: 12px; color: #d5dde4; font-size: 16px; }
  .dot { width: 10px; height: 10px; background: var(--lime); flex-shrink: 0; }

