---
import { content, type Lang } from '../i18n/home';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
const scoreValues = [52, 18, 35, 60];
const thanks = lang === 'es' ? '/es/gracias/' : '/thanks/';
---
<main>
  <!-- HERO -->
  <section class="hero grid-bg">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.sub}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={`#${ids.score}`}>{t.hero.primary}</a>
          <a class="btn btn-ghost" href={`#${ids.how}`}>{t.hero.secondary}</a>
        </div>
        <p class="hero-guarantee"><span class="dot" aria-hidden="true"></span>{t.hero.guarantee}</p>
      </div>

      <div class="score-card card" aria-hidden="true">
        <div class="score-top">
          <span class="mono label">{t.hero.card.label}</span>
          <img src="/brand/icon.svg" alt="" width="14" height="28" />
        </div>
        <div class="score-value"><span>41</span><span class="out">/ 100</span></div>
        <div class="bars">
          {t.hero.card.metrics.map((m, i) => (
            <div class="bar">
              <div class="bar-row"><span>{m}</span><span class="mono">{scoreValues[i]}</span></div>
              <div class="track"><div class="fill" style={`width:${scoreValues[i]}%`}></div></div>
            </div>
          ))}
        </div>
        <div class="score-foot">
          <span>{t.hero.card.lost}</span>
          <span class="lost">$•,•••</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAKS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.leaks.eyebrow}</p>
        <h2>{t.leaks.title}</h2>
        <p>{t.leaks.sub}</p>
      </div>
      <div class="leaks">
        {t.leaks.items.map((item, i) => (
          <div class="leak card">
            <span class="mono num">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SYSTEM -->
  <section class="section" id={ids.system}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.system.eyebrow}</p>
        <h2>{t.system.title}</h2>
        <p>{t.system.sub}</p>
      </div>
      <div class="layers">
        {t.system.layers.map((l, i) => (
          <div class="layer">
            <span class="mono layer-n">{`L${i + 1}`}</span>
            <h3>{l.title}</h3>
            <p>{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="section grid-bg" id={ids.how}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <ol class="steps">
        {t.how.steps.map((s) => (
          <li class="step card">
            <span class="mono step-label">{s.label}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- GUARANTEE -->
  <section class="section" id={ids.guarantee}>
    <div class="wrap guarantee">
      <div class="g-copy">
        <p class="eyebrow">{t.guarantee.eyebrow}</p>
        <h2>{t.guarantee.title}</h2>
        <p class="lead">{t.guarantee.body}</p>
      </div>
      <div class="g-box card">
        <ul>
          {t.guarantee.conditions.map((c) => <li>{c}</li>)}
        </ul>
        <p class="note">{t.guarantee.note}</p>
      </div>
    </div>
  </section>

  <!-- TRADES -->
  <section class="trades">
    <div class="wrap trades-inner">
      <h2 class="trades-title">{t.trades.title}</h2>
      <ul class="trade-list">
        {t.trades.list.map((tr) => <li>{tr}</li>)}
      </ul>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id={ids.pricing}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.pricing.eyebrow}</p>
        <h2>{t.pricing.title}</h2>
        <p>{t.pricing.sub}</p>
      </div>
      <div class="plans">
        {t.pricing.plans.map((p) => (
          <div class:list={['plan card', { featured: p.featured }]}>
            <h3>{p.name}</h3>
            <p class="price"><span>{p.price}</span>{p.unit && <span class="unit">{p.unit}</span>}</p>
            <p class="plan-body">{p.body}</p>
            <ul>
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost']} href={`#${ids.score}`}>{p.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id={ids.faq}>
    <div class="wrap faq-wrap">
      <div class="section-head">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.title}</h2>
      </div>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SCORE FORM -->
  <section class="section grid-bg" id={ids.score}>
    <div class="wrap score-wrap">
      <div class="section-head">
        <p class="eyebrow">{t.score.eyebrow}</p>
        <h2>{t.score.title}</h2>
        <p>{t.score.sub}</p>
      </div>

      <form class="form card" name="blueprint-score" method="POST" action={thanks} data-netlify="true" netlify-honeypot="company-website">
        <input type="hidden" name="form-name" value="blueprint-score" />
        <input type="hidden" name="language" value={lang} />
        <p class="sr-only"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>

        <div class="fields">
          <label>{t.score.fields.name}<input name="name" autocomplete="name" required /></label>
          <label>{t.score.fields.business}<input name="business" autocomplete="organization" required /></label>
          <label>{t.score.fields.trade}
            <select name="trade" required>
              <option value="" disabled selected>{t.score.tradePlaceholder}</option>
              {t.trades.list.map((tr) => <option value={tr}>{tr}</option>)}
            </select>
          </label>
          <label>{t.score.fields.city}<input name="city" autocomplete="address-level2" required /></label>
          <label>{t.score.fields.phone}<input name="phone" type="tel" autocomplete="tel" required /></label>
          <label>{t.score.fields.email}<input name="email" type="email" autocomplete="email" required /></label>
        </div>

        <label class="consent">
          <input type="checkbox" name="sms_consent" value="yes" />
          <span>
            {t.score.consent}{' '}
            <a href="/privacy-policy">{t.score.consentLinks.privacy}</a> · <a href="/terms">{t.score.consentLinks.terms}</a>
          </span>
        </label>

        <button class="btn btn-primary submit" type="submit">{t.score.submit}</button>
        <p class="form-note">{t.score.note}</p>
      </form>
    </div>
  </section>
</main>

<style>
  .lead { color: var(--body); font-size: 20px; line-height: 1.55; }

  /* Hero */
  .hero { padding: 96px 0 112px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 26px; }
  .hero h1 { font-size: clamp(42px, 6.4vw, 78px); line-height: 1.0; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-guarantee { display: flex; align-items: center; gap: 12px; color: #d5dde4; font-size: 16px; }
  .dot { width: 10px; height: 10px; background: var(--lime); flex-shrink: 0; }

  .score-card { padding: 28px; display: flex; flex-direction: column; gap: 22px; justify-self: end; width: 100%; max-width: 440px; }
  .score-top { display: flex; justify-content: space-between; align-items: center; }
  .score-top img { height: 28px; width: auto; }
  .label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .score-value { font-family: var(--font-display); font-weight: 700; font-size: 84px; line-height: 1; display: flex; align-items: baseline; gap: 10px; }
  .out { font-size: 28px; font-weight: 500; color: var(--steel); }
  .bars { display: flex; flex-direction: column; gap: 14px; }
  .bar-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px; }
  .bar-row .mono { color: var(--steel); }
  .track { height: 8px; border-radius: 4px; background: var(--line); }
  .fill { height: 8px; border-radius: 4px; background: var(--lime); }
  .score-foot { border-top: 1px solid var(--line); padding-top: 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 14px; color: var(--body); }
  .lost { font-family: var(--font-display); font-weight: 700; font-size: 28px; color: var(--lime); }

  /* Leaks */
  .leaks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .leak { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .leak h3 { font-size: 22px; }
  .leak p { color: var(--body); font-size: 16px; }
  .num { color: var(--lime); font-size: 13px; }

  /* Layers */
  .layers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .layer { padding: 32px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .layer h3 { font-size: 24px; }
  .layer p { color: var(--body); font-size: 16px; }
  .layer-n { color: var(--lime); font-size: 13px; }

  /* Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .step { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .step h3 { font-size: 26px; }
  .step p { color: var(--body); }
  .step-label { color: var(--lime); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* Guarantee */
  .guarantee { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: center; }
  .g-copy { display: flex; flex-direction: column; gap: 20px; }
  .g-copy h2 { font-size: clamp(34px, 5vw, 52px); }
  .g-box { padding: 32px; border-color: var(--lime); }
  .g-box ul { margin: 0 0 20px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .g-box li { padding-left: 26px; position: relative; color: #d5dde4; }
  .g-box li::before { content: ''; position: absolute; left: 0; top: 9px; width: 10px; height: 10px; background: var(--lime); }
  .note { color: var(--steel); font-size: 14px; }

  /* Trades */
  .trades { border-top: 1px solid var(--line); padding: 48px 0; background: var(--panel); }
  .trades-inner { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
  .trades-title { font-size: 22px; }
  .trade-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .trade-list li { font-family: var(--font-mono); font-size: 14px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 6px; color: #d5dde4; }

  /* Pricing */
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .plan { padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .plan.featured { border-color: var(--lime); }
  .plan h3 { font-size: 22px; }
  .price { font-family: var(--font-display); font-weight: 700; font-size: 52px; line-height: 1; }
  .unit { font-size: 20px; color: var(--steel); font-weight: 500; margin-left: 4px; }
  .plan-body { color: var(--body); }
  .plan ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .plan li { padding-left: 22px; position: relative; color: #d5dde4; font-size: 15px; }
  .plan li::before { content: ''; position: absolute; left: 0; top: 9px; width: 8px; height: 8px; background: var(--lime); }

  /* FAQ */
  .faq { border-top: 1px solid var(--line); max-width: 880px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding: 24px 40px 24px 0; position: relative;
    font-family: var(--font-display); font-weight: 500; font-size: 21px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 20px; font-size: 26px; color: var(--lime); }
  details[open] summary::after { content: '–'; }
  details p { color: var(--body); padding: 0 0 24px; max-width: 720px; }

  /* Form */
  .form { max-width: 880px; padding: 32px; display: flex; flex-direction: column; gap: 22px; }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .fields label { display: flex; flex-direction: column; gap: 8px; font-size: 14px; color: #d5dde4; }
  input, select {
    font: inherit; font-size: 16px; color: var(--chalk);
    background: var(--navy); border: 1px solid #2a3b4c; border-radius: 8px;
    min-height: 50px; padding: 0 14px;
  }
  input:focus, select:focus { border-color: var(--lime); outline: none; }
  .consent { display: flex; gap: 12px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: var(--steel); }
  .consent input { min-height: 0; width: 20px; height: 20px; margin-top: 2px; flex-shrink: 0; accent-color: var(--lime); }
  .submit { align-self: flex-start; min-height: 56px; padding: 0 32px; font-size: 18px; }
  .form-note { color: var(--steel); font-size: 14px; }

  @media (max-width: 1000px) {
    .hero-grid, .guarantee { grid-template-columns: minmax(0, 1fr); }
    .score-card { justify-self: start; }
    .leaks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .layers, .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { padding: 64px 0 80px; }
    .leaks, .layers, .plans, .fields { grid-template-columns: minmax(0, 1fr); }
    .layer, .leak, .step, .plan, .form, .g-box { padding: 24px; }
    .score-value { font-size: 64px; }
    .submit { width: 100%; }
  }
</style>
