---
// Home page: the free Score up top, the four leaks, the life of one missed call (scroll story, trade chips),
// the system in short (full version on /services),
// the speed guarantee and the Score form again. How it works and the FAQ moved
// to the Score, Services and Contact pages to keep this page short.
import { Image } from 'astro:assets';
import { content, type Lang } from '../i18n/home';
import { routes, pathIds } from '../i18n/routes';
import ScoreForm from './ScoreForm.astro';
import ScoreCard from './sections/ScoreCard.astro';
import Guarantee from './sections/Guarantee.astro';
import LeadStory from './sections/LeadStory.astro';
import Final from './sections/Final.astro';
import Fx from './Fx.astro';
import answerImg from '../assets/illustrations/answer.jpg';
import foundImg from '../assets/illustrations/found.jpg';
import bookedImg from '../assets/illustrations/booked.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
const pid = pathIds[lang];
const services = routes.services[lang];

const images = { found: foundImg, booked: bookedImg } as const;
const imgWidths = [480, 720, 1024];
const imgSizes = '(max-width: 1000px) calc(100vw - 48px), 380px';
const illustrated = t.system.paths.filter((p) => p.image);
const fullPath = t.system.paths.find((p) => !p.image)!;
// Line icons for the four leaks, drawn on a 24×24 grid in the blueprint style.
// Every stroke uses pathLength=100 so all four icons draw in exactly the same time.
const leakIcons = [
  '<path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11z" class="dash" style="--dash:5.6 4.5"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9V12M12 14.2v.1"/>',
  '<path d="M5 4h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/><path d="M15 3.5l5.5 5.5M20.5 3.5L15 9"/>',
  '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" class="dash" style="--dash:4.05 3.24"/>',
  '<path d="M6 3h8l4 4v6"/><path d="M6 3v18h7"/><path d="M14 3v4h4M9 10h6M9 13.5h4"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="M17.5 15.8v1.9l1.2.8"/>',
];
---
<main>
  <!-- HERO: the free Score is the one goal of the page -->
  <section class="hero grid-bg spot">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.sub}</p>
        <ScoreForm lang={lang} id={ids.score} uid={`${lang}-top`} />
        <p class="trust"><span class="dot" aria-hidden="true"></span>{t.hero.trust}</p>
        <p class="trust risk">{t.hero.risk}</p>
      </div>


      <ScoreCard lang={lang} />
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.leaks.eyebrow}</p>
        <h2>{t.leaks.title}</h2>
        <p>{t.leaks.sub}</p>
      </div>
      <div class="leaks" data-reveal="stagger">
        {t.leaks.items.map((item, i) => (
          <div class="leak card lift">
            <div class="leak-top">
              <svg class="icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={leakIcons[i].replace(/<(path|circle) /g, '<$1 pathLength="100" ')} />
              <span class="mono num">0{i + 1}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <p class="closing" data-scrub>{t.leaks.closing}</p>
    </div>
  </section>

  <LeadStory lang={lang} />

  <!-- THE SYSTEM, in short: each block links to its full version on the Services page -->
  <section class="section grid-bg spot" id={ids.system}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.system.eyebrow}</p>
        <h2>{t.system.title}</h2>
        <p>{t.system.sub}</p>
      </div>

      <div class="sum" data-reveal="stagger">
        <a class="sum-card sum-wide card sys" href={`${services}#${pid.foundation}`}>
          <figure class="illo">
            <Image src={answerImg} alt={t.system.foundation.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
          </figure>
          <div class="sum-copy">
            <span class="mono tag">{t.system.foundation.label}</span>
            <h3>{t.system.foundation.title}</h3>
            <p>{t.system.foundation.body}</p>
            <span class="more">{t.system.more} →</span>
          </div>
        </a>
        {illustrated.map((p) => (
          <a class="sum-card card sys" href={`${services}#${pid[p.image as 'found' | 'booked']}`}>
            <figure class="illo">
              <Image src={images[p.image as keyof typeof images]} alt={p.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
            </figure>
            <div class="sum-copy">
              <span class="mono tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p>{p.for}</p>
              <span class="more">{t.system.more} →</span>
            </div>
          </a>
        ))}
      </div>

      <a class="sum-full card sys" href={`${services}#${pid.full}`} data-reveal>
        <span class="mono tag">{fullPath.tag}</span>
        <strong>{fullPath.name}</strong>
        <span class="sum-full-body">{fullPath.body}</span>
        <span class="more">{t.system.more} →</span>
      </a>

      <div class="system-close" data-reveal>
        <p class="closing" data-scrub>{t.system.closing}</p>
        <a class="btn btn-primary" href={`#${ids.score}`} data-focus-form>{t.system.cta}</a>
      </div>
    </div>
  </section>

  <Guarantee lang={lang} />

  <Final lang={lang} />
</main>

<Fx />

<style>
  /* Hover cards lift and flip to Chalk (like the old site) */
  .lift { transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
  @media (hover: hover) {
    .lift:hover { transform: translateY(-4px); background: var(--chalk); border-color: var(--chalk); }
    .lift:hover h3 { color: var(--navy); }
    .lift:hover p { color: #2b3a48; }
    .lift:hover .num, .lift:hover .icon { color: var(--lime-ink); }
  }

  /* Hero */
  .hero { padding: 88px 0 104px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.0; }
  .trust { display: flex; align-items: center; gap: 12px; color: #d5dde4; font-size: 16px; }
  .trust.risk { margin-top: -14px; padding-left: 22px; color: var(--steel); font-size: 14px; }
  .dot { width: 10px; height: 10px; background: var(--lime); flex-shrink: 0; }

  /* Leaks */
  .leaks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .leak { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .leak-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .icon { color: var(--lime); transition: color .2s ease; }
  .leak h3 { font-size: 22px; }
  .leak p { color: var(--body); font-size: 16px; }

  /* The system, in short */
  .sum { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .sum-card { display: flex; flex-direction: column; gap: 20px; padding: 20px; color: inherit; text-decoration: none; }
  .sum-card:hover { color: inherit; }
  .sum-wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; padding: 28px; }
  .sum-copy { display: flex; flex-direction: column; gap: 12px; padding: 0 8px 8px; }
  .sum-copy h3 { font-size: clamp(26px, 3vw, 34px); }
  .sum-copy p { color: var(--chalk); }
  .more { color: var(--lime); font-weight: 500; margin-top: 4px; }
  .sys:hover .more { text-decoration: underline; }
  .sum-full { margin-top: 16px; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; color: inherit; text-decoration: none; }
  .sum-full:hover { color: inherit; }
  .sum-full strong { font-family: var(--font-display); font-size: 26px; }
  .sum-full-body { color: var(--body); flex: 1 1 280px; }
  .system-close { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 40px; }
  .system-close .closing { margin-top: 0; }

  /* Leak icons draw themselves on hover */
  @media (hover: hover) {
    .leak:hover .icon :global(path), .leak:hover .icon :global(circle) { animation: draw 2.2s cubic-bezier(.45, 0, .25, 1); }
  }
  .icon :global(.dash) { stroke-dasharray: var(--dash); }
  @keyframes draw { from { stroke-dasharray: 100; stroke-dashoffset: 100; } to { stroke-dasharray: 100; stroke-dashoffset: 0; } }

  @media (max-width: 1000px) {
    .hero-grid, .sum-wide { grid-template-columns: minmax(0, 1fr); }
    .leaks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 72px; }
    .leaks, .sum { grid-template-columns: minmax(0, 1fr); }
    .leak, .sum-wide { padding: 22px; }
    .sum-card { padding: 14px; }
  }
</style>
