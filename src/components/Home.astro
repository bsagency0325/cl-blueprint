---
import { Image } from 'astro:assets';
import { content, type Lang } from '../i18n/home';
import { site } from '../config';
import answerImg from '../assets/illustrations/answer.jpg';
import foundImg from '../assets/illustrations/found.jpg';
import bookedImg from '../assets/illustrations/booked.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
const scoreValues = [52, 18, 35, 60];
const scoreTotal = 41;
const thanks = lang === 'es' ? '/es/gracias/' : '/thanks/';
const guarantees = site.showSpeedGuarantee ? [t.guarantee.speed, ...t.guarantee.items] : t.guarantee.items;

const images = { found: foundImg, booked: bookedImg } as const;
const imgWidths = [480, 720, 1024];
const imgSizes = '(max-width: 1000px) calc(100vw - 48px), 560px';
const illustrated = t.system.paths.filter((p) => p.image);
const fullPath = t.system.paths.find((p) => !p.image)!;

// Leak calculator: missed calls a week × 4 weeks × job value × half would have booked.
const calc = { missed: 5, value: 500, values: [250, 500, 1000, 2500], max: 50 };
const money = (n: number) => '$' + n.toLocaleString('en-US');
const monthly = (missed: number, value: number) => missed * 4 * value * 0.5;
const formula = (missed: number, value: number) =>
  t.calc.formula.replace('{n}', String(missed)).replace('{v}', money(value));
---
<main>
  <!-- HERO + FORM -->
  <section class="hero grid-bg spot">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.sub}</p>

        <form id={ids.score} class="form card" name="blueprint-score" method="POST" action={thanks} data-netlify="true" netlify-honeypot="company-website">
          <input type="hidden" name="form-name" value="blueprint-score" />
          <input type="hidden" name="language" value={lang} />
          <p class="sr-only"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>

          <div class="fstep step1">
            <div class="row">
              <label><span>{t.form.step1.business}</span><input name="business" autocomplete="organization" required /></label>
              <label><span>{t.form.step1.city}</span><input name="city" autocomplete="address-level2" required /></label>
            </div>
            <button class="btn btn-primary next" type="button">{t.form.step1.button}</button>
            <p class="form-note">{t.form.step1.note}</p>
          </div>

          <div class="fstep step2">
            <h2 class="step2-title">{t.form.step2.heading}</h2>
            <div class="row three">
              <label><span>{t.form.step2.name}</span><input name="name" autocomplete="name" required /></label>
              <label><span>{t.form.step2.phone}</span><input name="phone" type="tel" autocomplete="tel" required aria-describedby={`phone-help-${lang}`} /><small id={`phone-help-${lang}`}>{t.form.step2.phoneHelp}</small></label>
              <label><span>{t.form.step2.email}</span><input name="email" type="email" autocomplete="email" required /></label>
            </div>
            <label class="consent">
              <input type="checkbox" name="sms_consent" value="yes" />
              <span>
                {t.form.step2.consent}{' '}
                <a href="/privacy-policy">{t.form.step2.privacy}</a> · <a href="/terms">{t.form.step2.terms}</a>
              </span>
            </label>
            <button class="btn btn-primary submit" type="submit">{t.form.step2.button}</button>
            <p class="form-note">{t.form.step2.note}</p>
          </div>
        </form>

        <p class="trust"><span class="dot" aria-hidden="true"></span>{t.hero.trust}</p>
      </div>

      <div class="score-card card" aria-hidden="true" data-score>
        <div class="score-top">
          <span class="mono label">{t.hero.card.label}</span>
          <img src="/brand/icon.svg" alt="" width="14" height="28" />
        </div>
        <div class="score-value"><span data-count={scoreTotal}>{scoreTotal}</span><span class="out">/ 100</span></div>
        <div class="bars">
          {t.hero.card.metrics.map((m, i) => (
            <div class="bar">
              <div class="bar-row"><span>{m}</span><span class="mono" data-count={scoreValues[i]}>{scoreValues[i]}</span></div>
              <div class="track"><div class="fill" style={`--w:${scoreValues[i]}%`}></div></div>
            </div>
          ))}
        </div>
        <div class="score-foot">
          <span>{t.hero.card.lost}</span>
          <span class="lost">$•,•••</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAK CALCULATOR -->
  <section class="section calc-section">
    <div class="wrap">
      <div class="calc card" data-calc data-reveal data-formula={t.calc.formula}>
        <div class="calc-copy">
          <p class="eyebrow">{t.calc.eyebrow}</p>
          <h2>{t.calc.title}</h2>
        </div>

        <div class="calc-inputs">
          <div class="calc-field">
            <span class="calc-label" id={`missed-${lang}`}>{t.calc.missedLabel}</span>
            <div class="stepper" role="group" aria-labelledby={`missed-${lang}`}>
              <button type="button" class="step-btn" data-step="-1" aria-label={t.calc.fewer}>−</button>
              <output class="missed" data-missed aria-live="polite">{calc.missed}</output>
              <button type="button" class="step-btn" data-step="1" aria-label={t.calc.more}>+</button>
            </div>
          </div>
          <div class="calc-field">
            <span class="calc-label" id={`value-${lang}`}>{t.calc.valueLabel}</span>
            <div class="chips" role="group" aria-labelledby={`value-${lang}`}>
              {calc.values.map((v, i) => (
                <button type="button" class="chip" data-value={v} aria-pressed={v === calc.value ? 'true' : 'false'}>
                  {money(v)}{i === calc.values.length - 1 ? '+' : ''}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="calc-result">
          <span class="calc-label">{t.calc.resultLabel}</span>
          <p class="calc-total"><output data-total aria-live="polite">{money(monthly(calc.missed, calc.value))}</output></p>
          <p class="calc-tail">{t.calc.resultTail}</p>
          <p class="mono calc-formula" data-formula-out>{formula(calc.missed, calc.value)}</p>
          <p class="calc-note">{t.calc.note}</p>
          <a class="btn btn-primary" href={`#${ids.score}`} data-focus-form>{t.calc.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.leaks.eyebrow}</p>
        <h2>{t.leaks.title}</h2>
        <p>{t.leaks.sub}</p>
      </div>
      <div class="leaks" data-reveal>
        {t.leaks.items.map((item, i) => (
          <div class="leak card lift">
            <span class="mono num">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY IT HAPPENS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.why.eyebrow}</p>
        <h2>{t.why.title}</h2>
      </div>
      <div class="cells two" data-reveal>
        {t.why.items.map((item) => (
          <div class="cell">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      {t.why.bonus && (
        <div class="bonus card" data-reveal>
          <span class="mono tag">{t.why.bonus.label}</span>
          <h3>{t.why.bonus.title}</h3>
          <p>{t.why.bonus.body}</p>
        </div>
      )}
      <p class="closing" data-reveal>{t.why.closing}</p>
    </div>
  </section>

  <!-- THE SYSTEM -->
  <section class="section grid-bg spot" id={ids.system}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.system.eyebrow}</p>
        <h2>{t.system.title}</h2>
        <p>{t.system.sub}</p>
      </div>

      <!-- Foundation: illustration + what's included + live text-back example -->
      <div class="foundation card">
        <figure class="illo" data-reveal>
          <Image src={answerImg} alt={t.system.foundation.imageAlt} widths={imgWidths} sizes={imgSizes} format="webp" quality={78} loading="lazy" />
          {t.system.foundation.callouts.map((c) => (
            <span class="callout mono" aria-hidden="true" style={`left:${c.x}%;top:${c.y}%;max-width:${c.w ?? 100 - c.x - 1}%`}>{c.text}</span>
          ))}
        </figure>
        <div class="foundation-copy">
          <span class="mono tag">{t.system.foundation.label}</span>
          <h3>{t.system.foundation.title}</h3>
          <p class="foundation-body">{t.system.foundation.body}</p>
          <ul class="ticks">
            {t.system.foundation.items.map((it) => <li>{it}</li>)}
          </ul>
          <div class="demo" data-demo>
            <p class="mono demo-label">{t.system.foundation.demoLabel}</p>
            <ol class="thread">
              {t.system.foundation.demo.map((m) => (
                <li class={`msg msg-${m.from}`}>{m.text}</li>
              ))}
            </ol>
          </div>
        </div>
      </div>

      <!-- Get Found + Get Booked -->
      <div class="paths">
        {illustrated.map((p) => (
          <div class="path card">
            <figure class="illo" data-reveal>
              <Image src={images[p.image as keyof typeof images]} alt={p.imageAlt} widths={imgWidths} sizes="(max-width: 1000px) calc(100vw - 48px), 560px" format="webp" quality={78} loading="lazy" />
              {p.callouts.map((c) => (
                <span class="callout mono" aria-hidden="true" style={`left:${c.x}%;top:${c.y}%;max-width:${c.w ?? 100 - c.x - 1}%`}>{c.text}</span>
              ))}
            </figure>
            <div class="path-copy">
              <span class="mono tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p class="for">{p.for}</p>
              <ul class="ticks">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
              <p class="promise"><span class="mono">{t.system.promiseLabel}</span>{p.promise}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Full Blueprint -->
      <div class="full card" data-reveal>
        <div>
          <span class="mono tag">{fullPath.tag}</span>
          <h3>{fullPath.name}</h3>
          <p class="for">{fullPath.for}</p>
        </div>
        <p class="path-body">{fullPath.body}</p>
        <p class="promise"><span class="mono">{t.system.promiseLabel}</span>{fullPath.promise}</p>
      </div>

      <div class="system-close" data-reveal>
        <p class="closing">{t.system.closing}</p>
        <a class="btn btn-ghost" href={`#${ids.score}`} data-focus-form>{t.system.cta}</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id={ids.how}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <ol class="steps" data-reveal>
        {t.how.steps.map((s, i) => (
          <li class="howstep card lift">
            <span class="mono num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="expect" data-reveal>
        <h3>{t.how.expectTitle}</h3>
        <dl>
          {t.how.expect.map((e) => (
            <div class="expect-row">
              <dt class="mono">{e.when}</dt>
              <dd>{e.body}{e.path && <span class="mono path-tag">{e.path}</span>}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- WHY IT WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.works.eyebrow}</p>
        <h2>{t.works.title}</h2>
      </div>
      <div class="cells three" data-reveal>
        {t.works.items.map((item) => (
          <div class="cell">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <p class="closing" data-reveal>{t.works.closing}</p>
    </div>
  </section>

  <!-- GUARANTEES -->
  <section class="section grid-bg spot" id={ids.guarantee}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.guarantee.eyebrow}</p>
        <h2>{t.guarantee.title}</h2>
      </div>
      <div class="g-box card" data-reveal>
        <dl>
          {guarantees.map((g) => (
            <div class="g-row">
              <dt class="mono">{g.label}</dt>
              <dd>{g.body}</dd>
            </div>
          ))}
        </dl>
        <p class="note">{t.guarantee.note}</p>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section">
    <div class="wrap founder" data-reveal>
      <div class="photo">
        {site.founderPhoto
          ? <img src={site.founderPhoto} alt={t.founder.photoAlt} width="480" height="560" loading="lazy" />
          : <img class="mark" src="/brand/icon.svg" alt="" width="60" height="120" />}
      </div>
      <div class="founder-copy">
        <p class="eyebrow">{t.founder.eyebrow}</p>
        <h2>{t.founder.title}</h2>
        <p class="lead">{t.founder.body}</p>
        <ul class="details mono">
          {t.founder.details.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id={ids.faq}>
    <div class="wrap faq-wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.title}</h2>
      </div>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL: SCORE + BOOK A CALL -->
  <section class="section grid-bg spot final" id={ids.contact}>
    <div class="wrap">
      <div class="final-head" data-reveal>
        <h2>{t.final.title}</h2>
        <p class="lead">{t.final.sub}</p>
      </div>
      <div class={`final-grid${site.calendarUrl ? ' has-cal' : ''}`}>
        <div class="final-card card primary-card" data-reveal>
          <span class="mono tag">Blueprint Score</span>
          <h3>{t.final.scoreTitle}</h3>
          <p>{t.final.scoreBody}</p>
          <a class="btn btn-primary big" href={`#${ids.score}`} data-focus-form>{t.final.button}</a>
        </div>
        <div class="final-card card" data-reveal>
          <span class="mono tag">15 min</span>
          <h3>{t.final.bookTitle}</h3>
          <p>{t.final.bookBody}</p>
          {site.calendarUrl
            ? <iframe class="calendar" src={site.calendarUrl} title={t.final.bookTitle} loading="lazy"></iframe>
            : <a class="btn btn-ghost" href={`mailto:${site.email}`}>{t.final.bookFallback}</a>}
          <div class="contact">
            {site.calendarUrl && <a href={`mailto:${site.email}`}>{t.final.email}<span class="mono addr"> · {site.email}</span></a>}
            {site.phone && <a href={`sms:${site.phone}`}>{t.final.phone}</a>}
            {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">{t.final.whatsapp}</a>}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  // Two-step Score form: step 2 appears after business name + city are filled in.
  // Without JavaScript both steps show at once and the form still submits.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[name="blueprint-score"]')) {
    form.classList.add('js');
    const step1 = form.querySelector<HTMLElement>('.step1')!;
    const next = form.querySelector<HTMLButtonElement>('.next')!;
    next.addEventListener('click', () => {
      const fields = [...step1.querySelectorAll('input')];
      const invalid = fields.find((f) => !f.checkValidity());
      if (invalid) { invalid.reportValidity(); return; }
      form.classList.add('on-step2');
      form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });
    step1.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target instanceof HTMLInputElement) { e.preventDefault(); next.click(); }
    });
  }
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-focus-form]')) {
    link.addEventListener('click', () => {
      setTimeout(() => document.querySelector<HTMLInputElement>('form[name="blueprint-score"] input[name="business"]')?.focus({ preventScroll: true }), 400);
    });
  }

  // Leak calculator: missed calls a week × 4 weeks × job value × half would have booked.
  for (const box of document.querySelectorAll<HTMLElement>('[data-calc]')) {
    const money = (n: number) => '$' + n.toLocaleString('en-US');
    const missedOut = box.querySelector<HTMLOutputElement>('[data-missed]')!;
    const totalOut = box.querySelector<HTMLOutputElement>('[data-total]')!;
    const formulaOut = box.querySelector<HTMLElement>('[data-formula-out]')!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>('[data-value]')];
    let missed = Number(missedOut.textContent) || 5;
    let value = Number(chips.find((c) => c.getAttribute('aria-pressed') === 'true')?.dataset.value) || 500;
    const render = () => {
      missedOut.textContent = String(missed);
      totalOut.textContent = money(missed * 4 * value * 0.5);
      formulaOut.textContent = (box.dataset.formula ?? '').replace('{n}', String(missed)).replace('{v}', money(value));
      for (const c of chips) c.setAttribute('aria-pressed', String(Number(c.dataset.value) === value));
    };
    for (const b of box.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      b.addEventListener('click', () => { missed = Math.min(50, Math.max(0, missed + Number(b.dataset.step))); render(); });
    }
    for (const c of chips) c.addEventListener('click', () => { value = Number(c.dataset.value); render(); });
  }

  // Motion effects. Skipped entirely for visitors who prefer reduced motion,
  // so everything is simply visible for them (and without JavaScript).
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('fx');

    const once = (els: Iterable<Element>, fn: (el: Element) => void, threshold = 0.2) => {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { fn(e.target); io.unobserve(e.target); }
      }, { threshold, rootMargin: '0px 0px -40px 0px' });
      for (const el of els) io.observe(el);
    };

    // Sections and illustration callouts fade in as they enter.
    once(document.querySelectorAll('[data-reveal]'), (el) => el.classList.add('in'), 0.12);

    // Score card counts up and its bars fill.
    once(document.querySelectorAll('[data-score]'), (card) => {
      card.classList.add('in');
      for (const n of card.querySelectorAll<HTMLElement>('[data-count]')) {
        const end = Number(n.dataset.count);
        const t0 = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / 1200);
          n.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        n.textContent = '0';
        requestAnimationFrame(tick);
      }
    }, 0.3);

    // Text-back example: messages arrive one by one.
    once(document.querySelectorAll('[data-demo]'), (demo) => {
      demo.querySelectorAll('.msg').forEach((m, i) => setTimeout(() => m.classList.add('shown'), 300 + i * 850));
    }, 0.4);

    // Blueprint grid lights up around the cursor (mouse and trackpad only).
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      for (const sec of document.querySelectorAll<HTMLElement>('.spot')) {
        sec.addEventListener('pointermove', (e) => {
          const r = sec.getBoundingClientRect();
          sec.style.setProperty('--mx', `${e.clientX - r.left}px`);
          sec.style.setProperty('--my', `${e.clientY - r.top}px`);
          sec.classList.add('lit');
        });
        sec.addEventListener('pointerleave', () => sec.classList.remove('lit'));
      }
    }
  }
</script>

<style>
  .lead { color: var(--body); font-size: 20px; line-height: 1.55; }
  .tag { color: var(--lime); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .num { color: var(--lime); font-size: 13px; }
  .closing { margin-top: 40px; font-family: var(--font-display); font-weight: 500; font-size: 24px; color: var(--chalk); max-width: 760px; }

  /* Effect 1: blueprint grid spotlight */
  .spot { position: relative; }
  .spot > .wrap { position: relative; z-index: 1; }
  .spot::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background-image:
      linear-gradient(rgba(156, 226, 74, 0.28) 1px, transparent 1px),
      linear-gradient(90deg, rgba(156, 226, 74, 0.28) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    mask-image: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), #000, transparent 70%);
    transition: opacity .35s ease;
  }
  .spot.lit::after { opacity: 1; }

  /* Effect 2: hover cards lift and flip to Chalk (like the old site) */
  .lift { transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
  @media (hover: hover) {
    .lift:hover { transform: translateY(-4px); background: var(--chalk); border-color: var(--chalk); }
    .lift:hover h3 { color: var(--navy); }
    .lift:hover p { color: #2b3a48; }
    .lift:hover .num { color: var(--lime-ink); }
  }

  /* Effect 4: sections and callouts fade in (only when the script turns motion on) */
  :global(.fx) [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  :global(.fx) [data-reveal].in { opacity: 1; transform: none; }
  :global(.fx) .illo .callout { opacity: 0; transform: translateY(calc(-100% + 6px)); transition: opacity .5s ease, transform .5s ease; }
  :global(.fx) .illo.in .callout { opacity: 1; transform: translateY(-100%); }
  :global(.fx) .illo.in .callout:nth-of-type(2) { transition-delay: .15s; }
  :global(.fx) .illo.in .callout:nth-of-type(3) { transition-delay: .3s; }
  :global(.fx) .illo.in .callout:nth-of-type(4) { transition-delay: .45s; }
