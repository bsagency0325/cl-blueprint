---
// Blueprint Score: the page every green button points to. Form and what we check side by side,
// then how it works, the Score questions and a short closing band.
import Page from '../../layouts/Page.astro';
import ScoreForm from '../ScoreForm.astro';
import CtaBand from '../sections/CtaBand.astro';
import How from '../sections/How.astro';
import Faq from '../sections/Faq.astro';
import Fx from '../Fx.astro';
import { content, type Lang } from '../../i18n/home';
import { pages } from '../../i18n/pages';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].score;
const t = content[lang];
const site = 'https://blueprintstrategies.us';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Blueprint Score',
  serviceType: lang === 'es' ? 'Auditoría de marketing gratis' : 'Free marketing audit',
  description: p.meta.description,
  url: new URL(routes.score[lang], site).href,
  provider: { '@type': 'ProfessionalService', name: 'Blueprint Strategies', url: site },
  areaServed: 'US',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}];
---
<Page lang={lang} page="score" title={p.meta.title} description={p.meta.description} schema={schema}>
  <main>
    <section class="hero grid-bg spot">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{p.head.eyebrow}</p>
          <h1>{p.head.title}</h1>
          <p class="lead">{p.head.sub}</p>
          <ScoreForm lang={lang} id={t.ids.score} uid={`${lang}-score`} />
          <p class="trust"><span class="dot" aria-hidden="true"></span>{t.hero.trust}</p>
        </div>
        <div class="checks card" data-reveal>
          <p class="mono tag">{p.checks.eyebrow}</p>
          <h2>{p.checks.title}</h2>
          <ol>
            {p.checks.items.map((c, i) => (
              <li>
                <span class="mono num">0{i + 1}</span>
                <div><h3>{c.title}</h3><p>{c.body}</p></div>
              </li>
            ))}
          </ol>
          <p class="checks-close">{p.checks.closing}</p>
        </div>
      </div>
    </section>

    <How lang={lang} />

    <Faq lang={lang} eyebrow={p.faq.eyebrow} title={p.faq.title} items={p.faq.items} />

    <CtaBand lang={lang} href={`#${t.ids.score}`} />
  </main>
  <Fx />
</Page>

<style>
  .hero { padding: 88px 0 104px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: start; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.02; }
  .trust { display: flex; align-items: center; gap: 12px; color: #d5dde4; font-size: 16px; }
  .dot { width: 10px; height: 10px; background: var(--lime); flex-shrink: 0; }

  .checks { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .checks h2 { font-size: 26px; }
  .checks ol { list-style: none; margin: 4px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .checks li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .checks li .num { padding-top: 3px; }
  .checks h3 { font-size: 17px; font-family: var(--font-body); font-weight: 500; letter-spacing: 0; }
  .checks li p { color: var(--body); font-size: 14px; line-height: 1.5; margin-top: 2px; }
  .checks-close { color: var(--chalk); font-size: 15px; }

  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 72px; }
    .checks { padding: 22px; }
  }
</style>
