---
// About: Piero's story (the page H1), how we work, why the name, and the Score form.
import Page from '../../layouts/Page.astro';
import Founder from '../sections/Founder.astro';
import Final from '../sections/Final.astro';
import Fx from '../Fx.astro';
import { content, type Lang } from '../../i18n/home';
import { pages } from '../../i18n/pages';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].about;
const t = content[lang];
const site = 'https://blueprintstrategies.us';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: new URL(routes.about[lang], site).href,
  inLanguage: lang,
  mainEntity: {
    '@type': 'Person',
    name: 'Piero Quino',
    jobTitle: lang === 'es' ? 'Fundador' : 'Founder',
    worksFor: { '@type': 'ProfessionalService', name: 'Blueprint Strategies', url: site },
    knowsLanguage: ['en', 'es'],
    homeLocation: { '@type': 'Place', name: 'Las Vegas, NV' },
  },
}];
---
<Page lang={lang} page="about" title={p.meta.title} description={p.meta.description} schema={schema}>
  <main>
    <div class="intro-band grid-bg spot">
      <div class="wrap"><p class="mono intro">{p.intro}</p></div>
    </div>
    <div class="founder-top">
      <Founder lang={lang} heading={1} />
    </div>

    <section class="section grid-bg spot">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{p.how.eyebrow}</p>
          <h2>{p.how.title}</h2>
        </div>
        <ul class="g-list" data-reveal>
          {p.how.items.map((g) => (
            <li>
              <span class="mono g-label">{g.label}</span>
              <span>{g.body}</span>
            </li>
          ))}
        </ul>
        <p class="closing" data-reveal>{t.guarantee.title} {t.guarantee.body}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap name" data-reveal>
        <img src="/brand/icon.svg" alt="" width="48" height="96" />
        <div class="name-copy">
          <p class="eyebrow">{p.name.eyebrow}</p>
          <h2>{p.name.title}</h2>
          <p class="lead">{p.name.body}</p>
        </div>
      </div>
    </section>

    <Final lang={lang} />
  </main>
  <Fx />
</Page>

<style>
  .intro-band { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .intro { color: var(--steel); font-size: 14px; letter-spacing: 0.04em; max-width: 900px; }
  .founder-top :global(.section) { border-top: 0; padding-top: 72px; }
  .g-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); max-width: 920px; }
  .g-list li { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); color: #d5dde4; }
  .g-label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lime); padding-top: 3px; }
  .name { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 40px; align-items: start; }
  .name img { width: 48px; height: auto; justify-self: center; margin-top: 8px; }
  .name-copy { display: flex; flex-direction: column; gap: 16px; max-width: 760px; }
  .name-copy h2 { font-size: clamp(34px, 5vw, 52px); }
  @media (max-width: 640px) {
    .g-list li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .name { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .name img { justify-self: start; width: 36px; }
    .founder-top :global(.section) { padding-top: 48px; }
  }
</style>
