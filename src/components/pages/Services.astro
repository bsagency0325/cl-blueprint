---
// Services: the whole system on one page (foundation + three paths), the speed guarantee,
// four questions about the system and the Score form. No prices.
import Page from '../../layouts/Page.astro';
import PageHead from '../sections/PageHead.astro';
import System from '../sections/System.astro';
import Guarantee from '../sections/Guarantee.astro';
import Faq from '../sections/Faq.astro';
import Final from '../sections/Final.astro';
import Fx from '../Fx.astro';
import { content, type Lang } from '../../i18n/home';
import { pages } from '../../i18n/pages';
import { routes, pathIds } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].services;
const t = content[lang];
const site = 'https://blueprintstrategies.us';
const url = new URL(routes.services[lang], site).href;
const provider = { '@type': 'ProfessionalService', name: 'Blueprint Strategies', url: site };
const f = t.system.foundation;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: p.head.eyebrow,
    itemListElement: [
      { name: f.title, description: f.items.join('. '), id: pathIds[lang].foundation },
      ...t.system.paths.map((path, i) => ({
        name: path.name,
        description: path.items.length ? path.items.join('. ') : path.body,
        id: [pathIds[lang].found, pathIds[lang].booked, pathIds[lang].full][i],
      })),
    ].map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'Service', name: s.name, description: s.description, url: `${url}#${s.id}`, provider, areaServed: 'US', availableLanguage: ['en', 'es'] },
    })),
  },
];
---
<Page lang={lang} page="services" title={p.meta.title} description={p.meta.description} schema={schema}>
  <main>
    <PageHead eyebrow={p.head.eyebrow} title={p.head.title} sub={p.head.sub}>
      <a class="btn btn-primary ph-cta" href={routes.score[lang]}>{t.system.cta}</a>
    </PageHead>
    <System lang={lang} />
    <Guarantee lang={lang} />
    <Faq lang={lang} eyebrow={p.faq.eyebrow} title={p.faq.title} items={p.faq.items} />
    <Final lang={lang} />
  </main>
  <Fx />
</Page>

<style>
  .ph-cta { align-self: flex-start; margin-top: 8px; }
</style>
