---
// Contact: book a call (or email while the calendar link is pending), other ways to reach us,
// a nudge to start with the Score, and the full FAQ ("Before you call").
import Page from '../../layouts/Page.astro';
import PageHead from '../sections/PageHead.astro';
import Faq from '../sections/Faq.astro';
import Fx from '../Fx.astro';
import { content, type Lang } from '../../i18n/home';
import { pages } from '../../i18n/pages';
import { routes } from '../../i18n/routes';
import { site } from '../../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].contact;
const t = content[lang];
const base = 'https://blueprintstrategies.us';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: new URL(routes.contact[lang], base).href,
  inLanguage: lang,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: 'Blueprint Strategies',
    url: base,
    email: site.email,
    ...(site.phone ? { telephone: site.phone } : {}),
    areaServed: 'US',
    address: { '@type': 'PostalAddress', addressLocality: 'Las Vegas', addressRegion: 'NV', addressCountry: 'US' },
  },
}];
---
<Page lang={lang} page="contact" title={p.meta.title} description={p.meta.description} schema={schema}>
  <main>
    <PageHead eyebrow={p.head.eyebrow} title={p.head.title} sub={p.head.sub} />

    <section class="section reach">
      <div class="wrap reach-grid">
        <div class="book card" data-reveal>
          <span class="mono tag">{lang === 'es' ? 'Sin presión' : 'No pressure'}</span>
          <h2>{p.book}</h2>
          {site.calendarUrl
            ? <iframe class="calendar" src={site.calendarUrl} title={p.book} loading="lazy"></iframe>
            : <a class="btn btn-primary" href={`mailto:${site.email}`}>{t.final.bookFallback}</a>}
        </div>
        <div class="side" data-reveal>
          <div class="ways card">
            <h3>{p.write}</h3>
            <a class="mono" href={`mailto:${site.email}`}>{site.email}</a>
            {site.phone && <a href={`sms:${site.phone}`}>{t.final.phone}</a>}
            {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">{t.final.whatsapp}</a>}
            <p class="mono where">{p.where}</p>
          </div>
          <div class="nudge card">
            <h3>{p.nudge.title}</h3>
            <p>{p.nudge.body}</p>
            <a class="btn btn-ghost" href={routes.score[lang]}>{p.nudge.button}</a>
          </div>
        </div>
      </div>
    </section>

    <Faq lang={lang} id={t.ids.faq} eyebrow={p.faq.eyebrow} title={p.faq.title} items={p.faq.items} />
  </main>
  <Fx />
</Page>

<style>
  .reach { border-top: 0; padding-top: 0; }
  .reach-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px; align-items: start; }
  .book { padding: 32px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .book h2 { font-size: clamp(28px, 3.4vw, 38px); }
  .book p, .nudge p { color: var(--body); }
  .calendar { width: 100%; min-height: 620px; border: 0; border-radius: 10px; background: var(--chalk); }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .ways, .nudge { padding: 28px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .ways h3, .nudge h3 { font-size: 22px; }
  .ways a { font-size: 16px; word-break: break-all; }
  .where { color: var(--steel); font-size: 13px; margin-top: 6px; }
  @media (max-width: 1000px) { .reach-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .book, .ways, .nudge { padding: 22px; } }
</style>
