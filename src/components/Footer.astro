---
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="col brand-col">
      <img src="/brand/logo-horizontal.svg" alt="Blueprint Strategies" width="145" height="60" />
      <p>
        {es
          ? 'Sistemas de crecimiento con IA para negocios de servicios del hogar.'
          : 'AI growth systems for home service businesses.'}
      </p>
      <p class="mono loc">Las Vegas, NV · {es ? 'Servimos en todo EE. UU.' : 'Serving the U.S.'}</p>
    </div>
    <nav class="col" aria-label={es ? 'Legal' : 'Legal'}>
      <a href="/privacy-policy">{es ? 'Política de privacidad' : 'Privacy Policy'}</a>
      <a href="/terms">{es ? 'Términos del servicio' : 'Terms of Service'}</a>
      <a href="/optin-blueprintstrategies">{es ? 'Suscripción SMS' : 'SMS Opt-In'}</a>
      <a href={es ? '/' : '/es/'} lang={es ? 'en' : 'es'}>{es ? 'English' : 'Español'}</a>
    </nav>
  </div>
  <div class="wrap bottom mono">© {year} Blueprint Strategies</div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding: 64px 0 32px; }
  .footer-inner { display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .col { display: flex; flex-direction: column; gap: 12px; }
  .brand-col img { height: 40px; width: auto; margin-bottom: 8px; align-self: flex-start; }
  .brand-col p { color: var(--body); max-width: 360px; }
  .loc { color: var(--steel); font-size: 13px; }
  .col a { color: var(--body); text-decoration: none; }
  .col a:hover { color: var(--chalk); }
  .bottom { margin-top: 48px; color: var(--steel); font-size: 13px; }
</style>
