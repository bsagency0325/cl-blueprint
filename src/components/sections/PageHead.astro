---
// Top of an inner page: eyebrow, the page's one H1 and a short line under it.
interface Props { eyebrow: string; title: string; sub?: string }
const { eyebrow, title, sub } = Astro.props;
---
<section class="page-head grid-bg spot">
  <div class="wrap">
    <div class="ph-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {sub && <p class="lead">{sub}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-head { padding: 88px 0 96px; }
  .ph-copy { display: flex; flex-direction: column; gap: 20px; max-width: 820px; }
  h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.02; }
  @media (max-width: 640px) { .page-head { padding: 56px 0 64px; } }
</style>
