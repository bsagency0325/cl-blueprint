---
// "Your trade" chips. Picking one rewrites every [data-tk] line on the page for that trade
// and replays the example screens. The choice is remembered across pages.
import type { Lang } from '../../i18n/home';
import { trades, tradeKeys, pickerLabel } from '../../i18n/trades';
interface Props { lang: Lang; center?: boolean }
const { lang, center = false } = Astro.props;
---
<div class={center ? 'picker center' : 'picker'} data-picker>
  <span class="mono p-label" id={`picker-${lang}`}>{pickerLabel[lang]}</span>
  <div class="chips" role="radiogroup" aria-labelledby={`picker-${lang}`}>
    {tradeKeys.map((k, i) => (
      <button type="button" class="chip" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-trade={k}>{trades[lang][k].label}</button>
    ))}
  </div>
</div>

<script>
  import { tradeLines, tradeKeys, type TradeKey } from '../../i18n/trades';
  const lang = document.documentElement.lang === 'es' ? 'es' : 'en';
  const KEY = 'bp-trade';

  const apply = (key: TradeKey, replay: boolean) => {
    const lines = tradeLines(lang, key);
    for (const el of document.querySelectorAll<HTMLElement>('[data-tk]')) {
      const v = lines[el.dataset.tk!];
      if (v) el.textContent = v;
    }
    for (const c of document.querySelectorAll<HTMLElement>('[data-trade]')) {
      c.setAttribute('aria-checked', String(c.dataset.trade === key));
    }
    if (replay) document.dispatchEvent(new CustomEvent('trade:change', { detail: key }));
  };

  if (document.querySelector('[data-picker]')) {
    document.addEventListener('click', (e) => {
      const chip = (e.target as Element).closest<HTMLElement>('[data-trade]');
      if (!chip) return;
      const key = chip.dataset.trade as TradeKey;
      try { localStorage.setItem(KEY, key); } catch {}
      apply(key, true);
    });
    // Arrow keys move between chips, like a radio group.
    document.addEventListener('keydown', (e) => {
      const chip = (e.target as Element).closest?.<HTMLElement>('[data-trade]');
      if (!chip || !['ArrowRight', 'ArrowLeft'].includes(e.key)) return;
      const all = [...chip.parentElement!.querySelectorAll<HTMLElement>('[data-trade]')];
      const next = all[(all.indexOf(chip) + (e.key === 'ArrowRight' ? 1 : all.length - 1)) % all.length];
      next.focus(); next.click();
    });
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (saved && saved !== 'hvac' && (tradeKeys as readonly string[]).includes(saved)) apply(saved as TradeKey, false);
  }
</script>

<style>
  .picker { display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; }
  .picker.center { justify-content: center; }
  .p-label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font: 500 15px var(--font-body); color: var(--chalk); background: var(--panel);
    border: 1px solid #2a3b4c; border-radius: 999px; min-height: 44px; padding: 0 18px; cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease, color .15s ease;
  }
  .chip:hover { border-color: var(--steel); }
  .chip[aria-checked='true'] { background: var(--lime); border-color: var(--lime); color: var(--navy); }
  @media (max-width: 640px) {
    .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 -24px; padding: 0 24px 4px; scrollbar-width: none; width: calc(100% + 48px); }
    .chips::-webkit-scrollbar { display: none; }
    .chip { flex-shrink: 0; }
  }
</style>
