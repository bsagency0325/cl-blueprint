---
// Parked: not used while the About section is off (Oct 31 2026). Kept so it can come back as is.
import { Image } from 'astro:assets';
import { content, type Lang } from '../../i18n/home';
import pieroImg from '../../assets/piero.jpg';

interface Props { lang: Lang; short?: boolean; heading?: 1 | 2 }
const { lang, short = false, heading = 2 } = Astro.props;
const t = content[lang];
---
<!-- FOUNDER -->
<section class="section">
  <div class="wrap founder" data-reveal>
    <div class="photo">
      <Image src={pieroImg} alt={t.founder.photoAlt} widths={[400, 640, 900]} sizes="(max-width: 1000px) 360px, 400px" format="webp" quality={80} loading="lazy" />
    </div>
    <div class="founder-copy">
      <p class="eyebrow">{t.founder.eyebrow}</p>
      {heading === 1 ? <h1>{t.founder.title}</h1> : <h2>{t.founder.title}</h2>}
      <p class="lead">{short ? t.founder.short : t.founder.body}</p>
      <ul class="details mono">
        {t.founder.details.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Founder */
  .founder { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 56px; align-items: center; }
  .photo { aspect-ratio: 6 / 7; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .founder-copy { display: flex; flex-direction: column; gap: 20px; }
  .founder-copy h1, .founder-copy h2 { font-size: clamp(34px, 5vw, 52px); }
  .details { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .details li { font-size: 13px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 6px; color: #d5dde4; }
  .details li:nth-child(-n+2) { border-color: var(--lime); color: var(--lime); }
  .more { font-weight: 500; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  @media (max-width: 1000px) {
    .founder { grid-template-columns: minmax(0, 1fr); }
    .photo { max-width: 360px; }
  }
</style>
