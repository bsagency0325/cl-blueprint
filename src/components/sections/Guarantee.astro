---
import { content, type Lang } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const ids = t.ids;
---
<!-- GUARANTEE: a stopwatch that answers well before 60 seconds -->
<section class="section grid-bg spot guarantee" id={ids.guarantee}>
  <div class="wrap g-grid">
    <div class="clock" data-clock data-reveal aria-hidden="true">
      <svg viewBox="0 0 220 220" width="220" height="220">
        <circle class="dial" cx="110" cy="110" r="96" />
        {Array.from({ length: 60 }, (_, i) => (
          <line class={i % 5 ? 'tick' : 'tick major'} x1="110" y1={i % 5 ? 20 : 16} x2="110" y2="26" transform={`rotate(${i * 6} 110 110)`} />
        ))}
        <circle class="sweep" cx="110" cy="110" r="96" pathLength="60" />
      </svg>
      <div class="clock-read">
        <span class="mono clock-time" data-clock-time>0:09</span>
        <span class="mono clock-stamp">{t.guarantee.clock} ✓</span>
      </div>
    </div>
    <div class="g-copy" data-reveal>
      <p class="eyebrow">{t.guarantee.eyebrow}</p>
      <h2>{t.guarantee.title}</h2>
      <p class="lead">{t.guarantee.body}</p>
      <ul class="g-list">
        {t.guarantee.items.map((g) => (
          <li>
            <span class="mono g-label">{g.label}</span>
            <span>{g.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Guarantee: stopwatch */
  .g-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; }
  .clock { position: relative; width: min(100%, 340px); aspect-ratio: 1; justify-self: center; }
  .clock svg { width: 100%; height: 100%; }
  .dial { fill: var(--panel); stroke: var(--line); stroke-width: 1; }
  .tick { stroke: #2a3b4c; stroke-width: 1; }
  .tick.major { stroke: var(--steel); stroke-width: 1.5; }
  .sweep { fill: none; stroke: var(--lime); stroke-width: 6; stroke-linecap: round; transform: rotate(-90deg); transform-origin: 110px 110px; stroke-dasharray: 9 60; }
  :global(.fx) [data-clock] .sweep { stroke-dasharray: 0 60; transition: stroke-dasharray 1.6s cubic-bezier(.3, .7, .2, 1); }
  :global(.fx) [data-clock].run .sweep { stroke-dasharray: 9 60; }
  .clock-read { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
  .clock-time { font-family: var(--font-display); font-weight: 700; font-size: clamp(44px, 6vw, 64px); color: var(--chalk); font-variant-numeric: tabular-nums; line-height: 1; }
  .clock-stamp { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy); background: var(--lime); padding: 5px 10px; border-radius: 4px; transform: rotate(-4deg); }
  :global(.fx) [data-clock] .clock-stamp { opacity: 0; transform: rotate(-4deg) scale(1.6); transition: opacity .25s ease, transform .35s cubic-bezier(.3, 1.6, .5, 1); }
  :global(.fx) [data-clock].done .clock-stamp { opacity: 1; transform: rotate(-4deg) scale(1); }
  .g-copy { display: flex; flex-direction: column; gap: 18px; }
  .g-copy h2 { font-size: clamp(34px, 5vw, 52px); }
  .g-list { list-style: none; margin: 8px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .g-list li { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--line); color: #d5dde4; }
  .g-label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lime); padding-top: 3px; }
  @media (max-width: 1000px) {
    .g-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .g-list li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .clock { width: 240px; }
  }
</style>
