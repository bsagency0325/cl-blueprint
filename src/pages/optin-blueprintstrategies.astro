---
import Simple from '../components/Simple.astro';
---
<Simple title="Blueprint Strategies SMS Opt-In" description="Opt in to receive SMS updates, reminders and occasional offers from Blueprint Strategies.">
  <h1>SMS Opt-In for Blueprint Strategies</h1>
  <p>Enter your details below and check the box to receive updates, reminders, and occasional offers from Blueprint Strategies.</p>

  <div class="form-frame">
    <iframe
      src="https://api.leadconnectorhq.com/widget/form/oQZ0d7yk6iqxDkoCf2rk"
      id="inline-oQZ0d7yk6iqxDkoCf2rk"
      data-layout="{'id':'INLINE'}"
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Blueprint Strategies Opt-in Form"
      data-height="577"
      data-layout-iframe-id="inline-oQZ0d7yk6iqxDkoCf2rk"
      data-form-id="oQZ0d7yk6iqxDkoCf2rk"
      title="Blueprint Strategies Opt-in Form"
      loading="lazy"></iframe>
  </div>
  <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>

  <p class="links"><a href="/privacy-policy">Privacy Policy</a> | <a href="/terms">Terms of Service</a></p>
</Simple>

<style>
  .form-frame { background: #ffffff; border-radius: 12px; padding: 12px; margin: 24px 0; min-height: 620px; }
  iframe { width: 100%; min-height: 600px; border: none; border-radius: 3px; }
  .links { text-align: center; }
</style>
